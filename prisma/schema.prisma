generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  mobile    String
  password  String
  lessons   Lesson[]
  createdAt DateTime @default(now())
}

model Lesson {
  id        String   @id @default(uuid())
  title     String
  content   String
  image     String?   // <-- optional image field
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}